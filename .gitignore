# Build artifacts and local binaries
/bin/
backend/web/dist/*
!backend/web/dist/index.html
node_modules/
dist/

# Databases and secrets — never commit (CONVENTIONS.md section 2)
*.db
*.db-wal
*.db-shm
.env
.env.*
!.env.example

# Agent distribution copies (regenerated by `make sync-agent`)
backend/internal/agentdist/files/*
!backend/internal/agentdist/files/README.txt

# LUMA agent — planning/process artifacts (not shipped)
docs/

# Runtime artifacts written by luma_agent.sh when run from the repo dir
debug.log
luma_cron.log
luma_agent.log
ping.txt
running_proc.txt
luma_reboot_check.cache

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~
